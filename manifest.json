{
  "manifest_version": 3,
  "name": "Shorts Blocker",
  "version": "0.0.1",
  "description": "Hide YouTube Shorts everywhere: search, home feed, subscriptions, sidebar, watch page and channels. Toggle it from the toolbar.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shorts Blocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "commands": {
    "toggle-blocking": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Turn Shorts blocking on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "css": ["hide-shorts.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
